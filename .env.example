# Runtime Vercel Functions: Neon pooled connection string (-pooler host)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require

# Optional: direct Neon connection for Drizzle schema migrations (no -pooler host)
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require

DASHBOARD_PASSWORD=replace-with-a-long-random-password
AUTH_SECRET=replace-with-at-least-32-random-characters
AGENT_TOKEN=replace-with-a-different-random-token
